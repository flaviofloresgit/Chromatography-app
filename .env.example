# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (CHROMATOGRAPHY APP)
# ==============================================================================
# Renombra o copia este archivo a '.env' y completa tus credenciales.
# En Streamlit Cloud, agrega estas mismas variables en "Settings" -> "Secrets".
# ==============================================================================

# 1. Google Gemini API Key (Requerido para la identificación por IA y Chat)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini recomendado (ej: gemini-2.5-flash, gemini-2.5-pro, etc.)
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Credentials (Opcional - si no se configuran, la app usa almacenamiento local automático)
# Obtén la URL y la anon/service_role key en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key_aqui

# Nombre del bucket de almacenamiento en Supabase para archivos y reportes PDF
SUPABASE_STORAGE_BUCKET=chromatography-files

# 3. Configuración de Base de Datos NIST local
NIST_MSP_PATH=database/Base de Datos NIST.MSP
NIST_DB_PATH=database/nist_library.sqlite
